@model List<Comment>

@{
    ViewData["Title"] = "CommentList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center">
            <h5 class="mb-0">Sigorta Makaleleri Kullanıcı Yorumları</h5>
            <form class="ms-auto position-relative">
                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-search"></i></div>
                <input class="form-control ps-5" type="text" placeholder="search">
            </form>
        </div>
        <div class="table-responsive mt-3">
            <table class="table align-middle table-hover">
                <thead class="table-secondary">
                    <tr>
                        <th>#</th>
                        <th>Ad Soyad</th>
                        <th>Makale</th>
                        <th>Tarih</th>
                        <th class="text-center">Durum</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CommentId</td>
                            <td><strong>@item.AppUser.Name @item.AppUser.Surname</strong></td>
                            <td>@item.Article.Title</td>
                            <td>@item.CommentDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                @if (item.CommentStatus=="1") @* Örn: Status true ise Aktif *@
                                {
                                    <span class="badge rounded-pill bg-success">Onaylandı</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-warning text-dark">Onay Bekliyor</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    @* Görüntüle *@
                                    <a href="/Default/Index/" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Görüntüle">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @* Düzenle *@
                                    <a href="/Comment/UpdateComment/@item.CommentId" class="btn btn-sm btn-outline-warning" data-bs-toggle="tooltip" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @* Onayla (Sadece onaylı değilse gösterilebilir) *@
                                    <a href="/Comment/ApproveComment/@item.CommentId" class="btn btn-sm btn-outline-success" data-bs-toggle="tooltip" title="Onayla">
                                        <i class="bi bi-check-lg"></i>
                                    </a>

                                    @* Sil *@
                                    <a href="/Comment/DeleteComment/@item.CommentId" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Sil" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
