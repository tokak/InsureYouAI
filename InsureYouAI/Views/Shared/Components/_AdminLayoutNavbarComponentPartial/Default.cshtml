<header class="top-header">
    <nav class="navbar navbar-expand gap-3">
        <div class="mobile-toggle-icon fs-3">
            <i class="bi bi-list"></i>
        </div>

        <form class="searchbar">
            <div class="position-absolute top-50 translate-middle-y search-icon ms-3">
                <i class="bi bi-search"></i>
            </div>
            <input class="form-control" type="text" placeholder="Aranacak kelimeyi giriniz...">
            <div class="position-absolute top-50 translate-middle-y search-close-icon">
                <i class="bi bi-x-lg"></i>
            </div>
        </form>

        <div class="top-navbar-right ms-auto">
            <ul class="navbar-nav align-items-center">

                <li class="nav-item search-toggle-icon">
                    <a class="nav-link" href="#">
                        <i class="bi bi-search"></i>
                    </a>
                </li>

                @await Component.InvokeAsync("_AdminLayoutNavbarMenuComponentPartial")

                <!-- MESAJLAR -->
                <li class="nav-item dropdown dropdown-large">
                    <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="#" data-bs-toggle="dropdown">
                        <div class="messages">
                            <span class="notify-badge">5</span>
                            <i class="bi bi-chat-right-fill"></i>
                        </div>
                    </a>

                    <div class="dropdown-menu dropdown-menu-end p-0">
                        <div class="p-2 border-bottom m-2">
                            <h5 class="mb-0">Mesajlar</h5>
                        </div>

                        <div class="header-message-list p-2">
                            <a class="dropdown-item" href="#">
                                <div class="d-flex align-items-center">
                                    <img src="~/snacked/assets/images/avatars/avatar-1.png" class="rounded-circle" width="50" height="50">
                                    <div class="ms-3 flex-grow-1">
                                        <h6 class="mb-0">
                                            Amelio Joly
                                            <span class="msg-time float-end text-secondary">1 dk</span>
                                        </h6>
                                        <small class="text-secondary">Lorem ipsum mesaj içeriği...</small>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="p-2">
                            <hr class="dropdown-divider">
                            <a class="dropdown-item text-center" href="#">
                                Tüm Mesajları Gör
                            </a>
                        </div>
                    </div>
                </li>

                <!-- BİLDİRİMLER -->
                <li class="nav-item dropdown dropdown-large">
                    <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="#" data-bs-toggle="dropdown">
                        <div class="notifications">
                            <span class="notify-badge">8</span>
                            <i class="bi bi-bell-fill"></i>
                        </div>
                    </a>

                    <div class="dropdown-menu dropdown-menu-end p-0">
                        <div class="p-2 border-bottom m-2">
                            <h5 class="mb-0">Bildirimler</h5>
                        </div>

                        <div class="header-notifications-list p-2">
                            <a class="dropdown-item" href="#">
                                <div class="d-flex align-items-center">
                                    <div class="notification-box bg-light-primary text-primary">
                                        <i class="bi bi-basket2-fill"></i>
                                    </div>
                                    <div class="ms-3 flex-grow-1">
                                        <h6 class="mb-0">
                                            Yeni Siparişler
                                            <span class="msg-time float-end text-secondary">1 dk</span>
                                        </h6>
                                        <small class="text-secondary">Yeni siparişleriniz var</small>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="p-2">
                            <hr class="dropdown-divider">
                            <a class="dropdown-item text-center" href="#">
                                Tüm Bildirimleri Gör
                            </a>
                        </div>
                    </div>
                </li>

                <!-- KULLANICI -->
                <li class="nav-item dropdown dropdown-user-setting">
                    <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="#" data-bs-toggle="dropdown">
                        <div class="user-setting d-flex align-items-center">
                            <img src="~/snacked/assets/images/avatars/avatar-1.png" class="user-img">
                        </div>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="#">
                                <div class="d-flex align-items-center">
                                    <img src="~/snacked/assets/images/avatars/avatar-1.png" class="rounded-circle" width="54" height="54">
                                    <div class="ms-3">
                                        <h6 class="mb-0">Murat Tokak</h6>
                                        <small class="text-secondary">Yönetici</small>
                                    </div>
                                </div>
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-person-fill me-2"></i> Profil
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-gear-fill me-2"></i> Ayarlar
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-speedometer me-2"></i> Dashboard
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-lock-fill me-2"></i> Çıkış Yap
                            </a>
                        </li>
                    </ul>
                </li>

            </ul>
        </div>
    </nav>
</header>
